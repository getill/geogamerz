{% extends 'base.html.twig' %}

{% block title %}Game Guesser{% endblock %}

{% block body %}
    <div class="game-container" style="text-align: center; font-family: sans-serif; padding: 20px;">
        <h1>🎮 Game Guesser</h1>

        <div id="loading" style="font-size: 1.2rem; margin-top: 20px;">Récupération des données depuis la base... 📡</div>

        <div id="game-zone" style="display: none; max-width: 600px; margin: 0 auto; background: #f9f9f9; padding: 20px; border-radius: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
            <h2 id="manche-title">Manche 1</h2>

            <div style="margin-bottom: 20px;">
                <img id="game-image" src="" alt="Devinez le jeu" style="max-width: 100%; max-height: 400px; border: 2px solid #333; border-radius: 8px;">
            </div>

            <div style="display: flex; flex-direction: column; gap: 12px; max-width: 300px; margin: 0 auto;">
                <input type="text" id="guess-name" placeholder="Nom du jeu" style="padding: 10px; border: 1px solid #ccc; border-radius: 5px;">
                <input type="text" id="guess-publisher" placeholder="Éditeur" style="padding: 10px; border: 1px solid #ccc; border-radius: 5px;">
                <input type="text" id="guess-coords" placeholder="Coordonnées" style="padding: 10px; border: 1px solid #ccc; border-radius: 5px;">

                <button id="btn-validate" style="padding: 12px; background: #007bff; color: white; border: none; border-radius: 5px; cursor: pointer; font-weight: bold;">Valider la manche</button>
            </div>

            <p id="feedback-message" style="font-weight: bold; margin-top: 20px; font-size: 1.1rem; color: #d35400;"></p>
        </div>
    </div>

    <script>
        let manches = [];
        let currentManche = 0;
        let scoreTotal = 0;

        // 1. Initialisation : on va chercher les vrais jeux en base de données
        async function startGame() {
            try {
                const response = await fetch('/api/games');
                manches = await response.json();

                if (manches.length === 0) {
                    document.getElementById('loading').innerText = "Oups, aucun jeu dans la base ! Ajoutes-en via EasyAdmin.";
                    return;
                }

                // On cache le texte de chargement et on affiche le jeu
                document.getElementById('loading').style.display = 'none';
                document.getElementById('game-zone').style.display = 'block';

                loadCurrentManche();
            } catch (error) {
                document.getElementById('loading').innerText = "Erreur de chargement de l'API.";
                console.error(error);
            }
        }

        // 2. Chargement des données visuelles de la manche en cours
        function loadCurrentManche() {
            const game = manches[currentManche];

            document.getElementById('manche-title').innerText = `Manche ${currentManche + 1} / ${manches.length}`;
            document.getElementById('game-image').src = game.imageUrl;

            // On vide les champs de texte pour le joueur
            document.getElementById('guess-name').value = '';
            document.getElementById('guess-publisher').value = '';
            document.getElementById('guess-coords').value = '';
            document.getElementById('feedback-message').innerText = '';
        }

        // 3. Logique de validation au clic sur le bouton
        document.getElementById('btn-validate').addEventListener('click', async () => {
            const game = manches[currentManche];
            let pointsManche = 0;

            // On récupère les valeurs entrées par le joueur (en minuscules pour faciliter la comparaison)
            const guessName = document.getElementById('guess-name').value.toLowerCase().trim();
            const guessPublisher = document.getElementById('guess-publisher').value.toLowerCase().trim();
            const guessCoords = document.getElementById('guess-coords').value.trim();

            // Système de points (100 points par bonne réponse)
            if (guessName === game.name.toLowerCase()) pointsManche += 100;
            if (guessPublisher === game.publisher.toLowerCase()) pointsManche += 100;
            if (guessCoords === game.coordinates) pointsManche += 100;

            scoreTotal += pointsManche;

            document.getElementById('feedback-message').innerText = `Tu as gagné ${pointsManche} points sur cette manche !`;

            currentManche++;

            // 4. Passage à la suite ou Fin du jeu
            if (currentManche < manches.length) {
                // On passe à la manche suivante après 1,5 seconde
                setTimeout(loadCurrentManche, 1500);
            } else {
                // Fin du jeu : on envoie le score final à la route /api/score
                document.getElementById('game-zone').innerHTML = `
                <h2>Fin de la partie ! 🏆</h2>
                <p>Score final : <strong>${scoreTotal} points</strong>.</p>
                <p id="save-status">Enregistrement en cours...</p>
            `;

                try {
                    const response = await fetch('/api/score', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ points: scoreTotal })
                    });

                    if (response.ok) {
                        document.getElementById('save-status').innerHTML = `<span style="color: green;">Score sauvegardé avec succès ! Retourne à l'accueil pour voir le classement.</span>`;
                    }
                } catch (error) {
                    console.error("Erreur lors de la sauvegarde du score", error);
                }
            }
        });

        // On lance la machine
        startGame();
    </script>
{% endblock %}
