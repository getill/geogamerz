{% extends 'base.html.twig' %}

{% block title %}Accueil - GeoGamerz{% endblock %}

{% block body %}
<div class="max-w-5xl mx-auto space-y-16 animate-in fade-in slide-in-from-bottom-4 duration-700 ease-out py-8">
    
    {# Hero Section #}
    <section class="flex flex-col items-center text-center space-y-6 pt-10 pb-8">
        <twig:Badge variant="secondary" class="mb-4 text-sm px-3 py-1">Saison 1 Ouverte !</twig:Badge>
        <h1 class="text-5xl font-extrabold tracking-tight lg:text-7xl bg-clip-text text-transparent bg-gradient-to-r from-primary via-accent to-primary">
            L'Arène Vous Attend.
        </h1>
        <p class="text-xl text-muted-foreground max-w-[600px] leading-relaxed">
            Rejoignez l'élite sur GeoGamerz. Cumulez des points, grimpez dans le classement mondial et prouvez votre valeur.
        </p>
        <div class="flex items-center space-x-4 pt-4">
            <twig:Button as="a" href="{{ path('app_game') }}" size="lg" class="px-8 text-md font-bold h-12">
                Jouer Maintenant
            </twig:Button>
            {% if not app.user %}
                <twig:Button as="a" href="{{ path('app_register') }}" variant="outline" size="lg" class="px-8 text-md font-bold h-12">
                    Créer un compte
                </twig:Button>
            {% endif %}
        </div>
    </section>

    {# Leaderboard Section #}
    <section id="leaderboard">
        <twig:Card class="overflow-hidden shadow-2xl border-border/50 bg-card/60 backdrop-blur-sm">
            <twig:Card:Header class="border-b bg-muted/10 pb-6">
                <twig:Card:Title class="text-2xl font-bold flex items-center gap-3">
                    <svg class="w-7 h-7 text-yellow-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
                    Top 10 Global
                </twig:Card:Title>
                <twig:Card:Description class="mt-2 text-base">Le classement des joueurs les plus performants de cette saison.</twig:Card:Description>
            </twig:Card:Header>
            <twig:Card:Content class="p-0">
                <twig:Table>
                    <twig:Table:Header class="bg-muted/5">
                        <twig:Table:Row class="hover:bg-transparent">
                            <twig:Table:Head class="h-14 px-8 text-left align-middle font-medium text-muted-foreground w-[120px]">Rang</twig:Table:Head>
                            <twig:Table:Head class="h-14 px-8 text-left align-middle font-medium text-muted-foreground">Joueur</twig:Table:Head>
                            <twig:Table:Head class="h-14 px-8 text-right align-middle font-medium text-muted-foreground">Score</twig:Table:Head>
                        </twig:Table:Row>
                    </twig:Table:Header>
                    <twig:Table:Body>
                        {% for score in topScores %}
                            {% set currentLoopIndex = loop.index %}
                            <twig:Table:Row class="group transition-colors hover:bg-muted/30">
                                <twig:Table:Cell class="px-8 py-5 align-middle font-medium">
                                    {% if currentLoopIndex == 1 %}
                                        <span class="inline-flex items-center justify-center rounded-full bg-yellow-500/20 text-yellow-500 h-10 w-10 ring-1 ring-inset ring-yellow-500/30 font-bold shadow-[0_0_15px_rgba(234,179,8,0.25)] text-lg">1</span>
                                    {% elseif currentLoopIndex == 2 %}
                                        <span class="inline-flex items-center justify-center rounded-full bg-slate-300/20 text-slate-300 h-10 w-10 ring-1 ring-inset ring-slate-300/30 font-bold shadow-[0_0_15px_rgba(203,213,225,0.2)] text-lg">2</span>
                                    {% elseif currentLoopIndex == 3 %}
                                        <span class="inline-flex items-center justify-center rounded-full bg-orange-500/20 text-orange-500 h-10 w-10 ring-1 ring-inset ring-orange-500/30 font-bold shadow-[0_0_15px_rgba(249,115,22,0.2)] text-lg">3</span>
                                    {% else %}
                                        <span class="text-muted-foreground inline-flex items-center justify-center h-10 w-10 text-lg font-medium">{{ currentLoopIndex }}</span>
                                    {% endif %}
                                </twig:Table:Cell>
                                <twig:Table:Cell class="px-8 py-5 align-middle">
                                    <div class="flex items-center space-x-4">
                                        <twig:Avatar class="h-12 w-12 border-2 border-transparent group-hover:border-primary/50 transition-colors shadow-sm">
                                            <twig:Avatar:Fallback class="bg-muted text-muted-foreground font-semibold text-sm">
                                                {{ score.player.userIdentifier|slice(0, 2)|upper }}
                                            </twig:Avatar:Fallback>
                                        </twig:Avatar>
                                        <span class="font-semibold group-hover:text-primary transition-colors text-lg tracking-tight">{{ score.player.userIdentifier }}</span>
                                    </div>
                                </twig:Table:Cell>
                                <twig:Table:Cell class="px-8 py-5 align-middle text-right">
                                    <twig:Badge variant="outline" class="px-4 py-1.5 text-base font-bold bg-primary/10 text-primary border-primary/20 group-hover:bg-primary/20 transition-colors">
                                        {{ score.points|number_format(0, ',', ' ') }} pts
                                    </twig:Badge>
                                </twig:Table:Cell>
                            </twig:Table:Row>
                        {% else %}
                            <twig:Table:Row>
                                <twig:Table:Cell colspan="3" class="p-16 text-center text-muted-foreground">
                                    <div class="flex flex-col items-center space-y-4">
                                        <svg class="h-12 w-12 text-muted-foreground/30" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                                        <p class="text-lg">Aucun score n'a été enregistré pour le moment.<br>Soyez le premier !</p>
                                    </div>
                                </twig:Table:Cell>
                            </twig:Table:Row>
                        {% endfor %}
                    </twig:Table:Body>
                </twig:Table>
            </twig:Card:Content>
        </twig:Card>
    </section>
</div>
{% endblock %}
