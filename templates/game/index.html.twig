{% extends 'base.html.twig' %}

{% block title %}Game Guesser - GeoGamerz{% endblock %}

{% block stylesheets %}
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        /* HUD scanner motifs with no equivalent Tailwind utility: scanline sweep + terminal typing/caret. */
        @keyframes hud-scan { 0% { top: 0%; } 100% { top: 100%; } }
        .animate-hud-scan { animation: hud-scan 2.4s linear infinite; }

        .hud-boot-line { overflow: hidden; white-space: nowrap; width: 0; border-right: 2px solid transparent; }
        .hud-boot-line[data-active] {
            color: var(--foreground);
            border-right-color: var(--primary);
            animation: hud-type 420ms ease-out forwards, hud-caret 0.8s step-end infinite;
        }
        .hud-boot-line[data-done] { color: var(--foreground); border-right-color: transparent; width: 100%; animation: none; }
        @keyframes hud-type { to { width: 100%; } }
        @keyframes hud-caret { 50% { border-color: transparent; } }

        @media (prefers-reduced-motion: reduce) {
            .animate-hud-scan { animation: none; }
            .hud-boot-line[data-active] { animation: none; width: 100%; }
        }
    </style>
{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto py-8 animate-in fade-in slide-in-from-bottom-4 duration-700 ease-out" data-controller="game">

    {# Setup: difficulty & round count #}
    <div id="hud-setup" class="max-w-md mx-auto" data-game-target="setup">
        <div class="relative rounded-2xl border border-border bg-card/60 backdrop-blur-sm shadow-2xl px-10 py-10">
            <twig:Badge variant="secondary" class="mb-6 gap-2 h-auto py-1 px-3 font-mono text-[11px] tracking-widest uppercase">
                <span class="relative flex h-1.5 w-1.5">
                    <span class="motion-safe:animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-primary"></span>
                </span>
                Paramètres de mission
            </twig:Badge>

            <div class="mb-6">
                <p class="font-mono text-[11px] uppercase tracking-widest text-muted-foreground mb-3">&gt; Niveau de difficulté</p>
                <div class="grid grid-cols-3 gap-2" id="level-select">
                    <button type="button" data-level="1" data-game-target="levelButton" data-action="click->game#selectLevel" class="level-btn flex flex-col items-center justify-center gap-0.5 rounded-lg border border-border py-3 font-mono transition-colors hover:border-primary hover:text-primary">
                        <span class="text-lg font-bold">1</span>
                        <span class="text-[10px] normal-case text-muted-foreground">Facile</span>
                    </button>
                    <button type="button" data-level="2" data-game-target="levelButton" data-action="click->game#selectLevel" class="level-btn flex flex-col items-center justify-center gap-0.5 rounded-lg border border-border py-3 font-mono transition-colors hover:border-primary hover:text-primary">
                        <span class="text-lg font-bold">2</span>
                        <span class="text-[10px] normal-case text-muted-foreground">Moyen</span>
                    </button>
                    <button type="button" data-level="3" data-game-target="levelButton" data-action="click->game#selectLevel" class="level-btn flex flex-col items-center justify-center gap-0.5 rounded-lg border border-border py-3 font-mono transition-colors hover:border-primary hover:text-primary">
                        <span class="text-lg font-bold">3</span>
                        <span class="text-[10px] normal-case text-muted-foreground">Difficile</span>
                    </button>
                </div>
                <p class="mt-2 text-[11px] text-muted-foreground">Plus le niveau est élevé, plus il faut d'infos correctes pour valider une manche.</p>
            </div>

            <div class="mb-8">
                <p class="font-mono text-[11px] uppercase tracking-widest text-muted-foreground mb-3">&gt; Nombre de manches</p>
                <div class="grid grid-cols-3 gap-2" id="rounds-select">
                    <button type="button" data-rounds="5" data-game-target="roundsButton" data-action="click->game#selectRounds" class="rounds-btn flex items-center justify-center rounded-lg border border-border py-3 font-mono text-lg font-bold transition-colors hover:border-primary hover:text-primary">5</button>
                    <button type="button" data-rounds="10" data-game-target="roundsButton" data-action="click->game#selectRounds" class="rounds-btn flex items-center justify-center rounded-lg border border-border py-3 font-mono text-lg font-bold transition-colors hover:border-primary hover:text-primary">10</button>
                    <button type="button" data-rounds="15" data-game-target="roundsButton" data-action="click->game#selectRounds" class="rounds-btn flex items-center justify-center rounded-lg border border-border py-3 font-mono text-lg font-bold transition-colors hover:border-primary hover:text-primary">15</button>
                </div>
            </div>

            <twig:Button type="button" id="start-game-btn" data-game-target="startButton" data-action="click->game#start" class="w-full h-12 text-md font-bold">
                Lancer la partie
            </twig:Button>
        </div>
    </div>

    {# Boot / connection sequence #}
    <div id="hud-boot" class="max-w-md mx-auto hidden" data-game-target="boot">
        <div class="relative rounded-2xl border border-border bg-card/60 backdrop-blur-sm shadow-2xl px-10 py-12 text-center">
            <twig:Badge variant="secondary" class="mb-6 gap-2 h-auto py-1 px-3 font-mono text-[11px] tracking-widest uppercase">
                <span class="relative flex h-1.5 w-1.5">
                    <span class="motion-safe:animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-primary"></span>
                </span>
                Connexion en cours
            </twig:Badge>

            <div class="relative w-24 h-24 mx-auto mb-6">
                <span class="absolute -inset-8 rounded-full bg-primary/30 blur-2xl motion-safe:animate-pulse motion-reduce:hidden" aria-hidden="true"></span>
                <span class="absolute inset-0 rounded-full border-2 border-primary/25 border-t-primary border-r-primary motion-safe:animate-spin motion-reduce:hidden"></span>
                <span class="absolute inset-0 flex items-center justify-center text-3xl">📡</span>
            </div>

            <div class="font-mono text-[13px] text-muted-foreground text-left min-h-[80px] space-y-2 mb-6" id="boot-lines">
                <p class="hud-boot-line" data-game-target="bootLine">&gt; Connexion au satellite...</p>
                <p class="hud-boot-line" data-game-target="bootLine">&gt; Synchronisation des manches...</p>
                <p class="hud-boot-line" data-game-target="bootLine">&gt; Calibrage du viseur...</p>
            </div>

            <div class="h-1.5 rounded-full bg-muted overflow-hidden">
                <div id="boot-bar" data-game-target="bootBar" class="h-full rounded-full bg-primary shadow-[0_0_12px_1px_rgba(220,38,38,0.6)]" style="width: 0%"></div>
            </div>
        </div>
    </div>

    {# Active round #}
    <div id="hud-game" class="hidden" data-game-target="game">
        <twig:Badge variant="secondary" class="mb-4 gap-2 h-auto py-1 px-3 font-mono text-[11px] tracking-widest uppercase">
            <span class="relative flex h-1.5 w-1.5">
                <span class="motion-safe:animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
                <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-primary"></span>
            </span>
            <span id="round-counter" data-game-target="roundCounter">Manche 1/1</span>
        </twig:Badge>

        <div class="grid gap-7 md:grid-cols-2 items-start">
            {# Target image, HUD-framed #}
            <div class="relative aspect-square">
                <span class="absolute -top-8 left-1/2 -translate-x-1/2 w-64 h-64 rounded-full bg-primary/25 blur-3xl motion-safe:animate-pulse motion-reduce:hidden" aria-hidden="true"></span>

                <span class="absolute top-1 left-1 w-6 h-6 border-t-2 border-l-2 border-primary rounded-tl-md z-10"></span>
                <span class="absolute top-1 right-1 w-6 h-6 border-t-2 border-r-2 border-primary rounded-tr-md z-10"></span>
                <span class="absolute bottom-1 left-1 w-6 h-6 border-b-2 border-l-2 border-primary rounded-bl-md z-10"></span>
                <span class="absolute bottom-1 right-1 w-6 h-6 border-b-2 border-r-2 border-primary rounded-br-md z-10"></span>

                <div class="relative w-full h-full rounded-2xl overflow-hidden border border-border shadow-2xl bg-black/20">
                    <img id="game-image" data-game-target="image" src="" alt="Devinez le jeu" class="w-full h-full object-contain transition-opacity duration-300">
                    <span class="absolute left-0 right-0 h-0.5 bg-primary/80 shadow-[0_0_12px_2px_rgba(220,38,38,0.7)] animate-hud-scan motion-reduce:hidden" aria-hidden="true"></span>
                    <span id="target-label" data-game-target="targetLabel" class="absolute bottom-2 left-2 font-mono text-[10px] uppercase tracking-wider text-primary bg-background/60 backdrop-blur px-1.5 py-0.5 rounded"></span>
                </div>
            </div>

            {# Guess panel #}
            <twig:Card class="p-6 shadow-2xl border-border/50 bg-card/60 backdrop-blur-sm">
                <p class="font-mono text-[11px] uppercase tracking-widest text-primary mb-1">&gt; Scan module</p>
                <h1 class="text-2xl font-black uppercase tracking-tight mb-1">Devine le jeu</h1>
                <p class="text-sm text-muted-foreground mb-5">Renseigne les champs détectés pour ce titre.</p>

                <form id="guess-form" class="space-y-3" data-game-target="form" data-action="submit->game#submitGuess">
                    <div class="field-row hidden items-center gap-2.5 border-b border-dashed border-border pb-2.5" data-field="name">
                        <span class="font-mono text-primary text-xs shrink-0">›</span>
                        <label for="guess-name" class="font-mono text-[10px] uppercase tracking-wide text-muted-foreground w-28 shrink-0">Nom du jeu</label>
                        <input id="guess-name" type="text" autocomplete="off" placeholder="Ex: Super Mario 64"
                               class="flex-1 min-w-0 bg-transparent border-0 border-b border-transparent focus:border-primary outline-none font-mono text-sm py-1 disabled:opacity-60">
                        <span class="field-status w-5 text-center text-sm scale-0 opacity-0 transition-all duration-200"></span>
                    </div>
                    <div class="field-row hidden items-center gap-2.5 border-b border-dashed border-border pb-2.5" data-field="releaseYear">
                        <span class="font-mono text-primary text-xs shrink-0">›</span>
                        <label for="guess-year" class="font-mono text-[10px] uppercase tracking-wide text-muted-foreground w-28 shrink-0">Année de sortie</label>
                        <input id="guess-year" type="text" autocomplete="off" placeholder="Ex: 2017"
                               class="flex-1 min-w-0 bg-transparent border-0 border-b border-transparent focus:border-primary outline-none font-mono text-sm py-1 disabled:opacity-60">
                        <span class="field-status w-5 text-center text-sm scale-0 opacity-0 transition-all duration-200"></span>
                    </div>
                    <div class="field-row hidden items-center gap-2.5 border-b border-dashed border-border pb-2.5" data-field="publisher">
                        <span class="font-mono text-primary text-xs shrink-0">›</span>
                        <label for="guess-publisher" class="font-mono text-[10px] uppercase tracking-wide text-muted-foreground w-28 shrink-0">Éditeur</label>
                        <input id="guess-publisher" type="text" autocomplete="off" placeholder="Ex: Nintendo"
                               class="flex-1 min-w-0 bg-transparent border-0 border-b border-transparent focus:border-primary outline-none font-mono text-sm py-1 disabled:opacity-60">
                        <span class="field-status w-5 text-center text-sm scale-0 opacity-0 transition-all duration-200"></span>
                    </div>
                    <div class="field-row hidden items-center gap-2.5 border-b border-dashed border-border pb-2.5" data-field="protagonist">
                        <span class="font-mono text-primary text-xs shrink-0">›</span>
                        <label for="guess-protagonist" class="font-mono text-[10px] uppercase tracking-wide text-muted-foreground w-28 shrink-0">Protagoniste</label>
                        <input id="guess-protagonist" type="text" autocomplete="off" placeholder="Ex: Link"
                               class="flex-1 min-w-0 bg-transparent border-0 border-b border-transparent focus:border-primary outline-none font-mono text-sm py-1 disabled:opacity-60">
                        <span class="field-status w-5 text-center text-sm scale-0 opacity-0 transition-all duration-200"></span>
                    </div>

                    <twig:Button type="submit" data-game-target="submitButton" class="w-full h-12 text-md font-bold mt-2">
                        Valider la manche
                    </twig:Button>
                </form>

                <div id="round-result" class="hidden mt-4 flex items-center justify-between gap-3" data-game-target="result"></div>
            </twig:Card>
        </div>
    </div>

    <div id="hud-finish" class="hidden max-w-lg mx-auto" data-game-target="finish"></div>
</div>
{% endblock %}
