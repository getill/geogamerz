{% extends 'base.html.twig' %}

{% block title %}Classement - GeoGamerz{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-700 ease-out">
    <div class="flex flex-col space-y-2 text-center my-8">
        <h1 class="text-4xl font-extrabold tracking-tight lg:text-5xl">Hall of Fame</h1>
        <p class="text-lg text-muted-foreground">Découvrez les meilleurs joueurs de GeoGamerz.</p>
    </div>

    <div class="rounded-xl border bg-card text-card-foreground shadow-sm overflow-hidden">
        <div class="flex flex-col space-y-1.5 p-6 pb-4 border-b bg-muted/20">
            <h3 class="font-semibold leading-none tracking-tight text-xl">Top 10 Global</h3>
            <p class="text-sm text-muted-foreground pt-1">Classement basé sur le total des points accumulés.</p>
        </div>
        <div class="p-0">
            <div class="relative w-full overflow-auto">
                <table class="w-full caption-bottom text-sm">
                    <thead class="[&_tr]:border-b">
                        <tr class="border-b transition-colors hover:bg-muted/50">
                            <th class="h-12 px-6 text-left align-middle font-medium text-muted-foreground">Rang</th>
                            <th class="h-12 px-6 text-left align-middle font-medium text-muted-foreground">Joueur</th>
                            <th class="h-12 px-6 text-right align-middle font-medium text-muted-foreground">Score</th>
                        </tr>
                    </thead>
                    <tbody class="[&_tr:last-child]:border-0">
                        {% for score in topScores %}
                            <tr class="border-b transition-colors hover:bg-muted/50 group">
                                <td class="p-6 align-middle font-medium w-[100px]">
                                    {% if loop.index == 1 %}
                                        <span class="inline-flex items-center justify-center rounded-full bg-yellow-500/20 text-yellow-500 h-8 w-8 ring-1 ring-inset ring-yellow-500/30 font-bold shadow-[0_0_10px_rgba(234,179,8,0.2)]">1</span>
                                    {% elseif loop.index == 2 %}
                                        <span class="inline-flex items-center justify-center rounded-full bg-slate-300/20 text-slate-300 h-8 w-8 ring-1 ring-inset ring-slate-300/30 font-bold shadow-[0_0_10px_rgba(203,213,225,0.2)]">2</span>
                                    {% elseif loop.index == 3 %}
                                        <span class="inline-flex items-center justify-center rounded-full bg-orange-500/20 text-orange-500 h-8 w-8 ring-1 ring-inset ring-orange-500/30 font-bold shadow-[0_0_10px_rgba(249,115,22,0.2)]">3</span>
                                    {% else %}
                                        <span class="text-muted-foreground inline-flex items-center justify-center h-8 w-8">{{ loop.index }}</span>
                                    {% endif %}
                                </td>
                                <td class="p-6 align-middle">
                                    <div class="flex items-center space-x-3">
                                        <div class="h-9 w-9 shrink-0 overflow-hidden rounded-full bg-muted flex items-center justify-center ring-1 ring-border group-hover:ring-primary/50 transition-all">
                                            <svg class="h-5 w-5 text-muted-foreground group-hover:text-primary transition-colors" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                        </div>
                                        <span class="font-medium group-hover:text-primary transition-colors text-base">{{ score.player.userIdentifier }}</span>
                                    </div>
                                </td>
                                <td class="p-6 align-middle text-right">
                                    <div class="inline-flex items-center justify-center rounded-md border px-3 py-1 text-sm font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 border-transparent bg-primary/10 text-primary hover:bg-primary/20">
                                        {{ score.points|number_format(0, ',', ' ') }} pts
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="3" class="p-12 text-center text-muted-foreground">
                                    <div class="flex flex-col items-center space-y-3">
                                        <svg class="h-10 w-10 text-muted-foreground/50" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                                        <p>Aucun score n'a été enregistré pour le moment.<br>À toi de jouer !</p>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
