{% extends 'base.html.twig' %}

{% block title %}GeoGamerz — L'Arène du Quiz{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto space-y-24 motion-safe:animate-in motion-safe:fade-in motion-safe:slide-in-from-bottom-4 duration-700 ease-out py-4">

    {# Hero #}
    <section class="relative flex flex-col items-center text-center space-y-6 pt-14 pb-10 overflow-hidden">
        <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[600px] h-[600px] rounded-full bg-primary/20 blur-3xl motion-reduce:hidden" aria-hidden="true"></div>

        <twig:Badge variant="secondary" class="relative px-3 py-1 text-sm gap-2">
            <span class="relative flex h-2 w-2">
                <span class="motion-safe:animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
            </span>
            Saison 1 en direct
        </twig:Badge>

        <h1 class="relative text-6xl font-black tracking-tighter uppercase lg:text-8xl text-foreground leading-[0.95]">
            Devine<span class="text-primary">.</span><br>Score<span class="text-primary">.</span><br>Domine<span class="text-primary">.</span>
        </h1>
        <p class="relative text-xl text-muted-foreground max-w-[600px] leading-relaxed">
            Une image. Trois questions. Un jeu culte à démasquer. Rejoignez l'arène GeoGamerz et grimpez au sommet du classement.
        </p>
        <div class="relative flex items-center space-x-4 pt-4">
            <twig:Button as="a" href="{{ path('app_game') }}" size="lg" class="px-8 h-14 text-lg font-bold shadow-[0_0_40px_rgba(220,38,38,0.35)] hover:shadow-[0_0_50px_rgba(220,38,38,0.5)] transition-shadow">
                Entrer dans l'arène
            </twig:Button>
            {% if not app.user %}
                <twig:Button as="a" href="{{ path('app_register') }}" variant="outline" size="lg" class="px-8 h-14 text-lg font-bold">
                    Créer un compte
                </twig:Button>
            {% endif %}
        </div>
    </section>

    {# Example games #}
    <section class="space-y-6">
        <div class="text-center space-y-2">
            <h2 class="text-3xl font-black tracking-tight uppercase">Les défis du moment</h2>
            <p class="text-muted-foreground">Autant de couvertures. Autant de pièges. À vous de les démasquer.</p>
        </div>
        <div class="flex flex-wrap justify-center gap-6 pt-4">
            {% for game in games %}
                {% set tilt = loop.index0 is even ? '-rotate-2' : 'rotate-2' %}
                <div class="group relative w-44 sm:w-52 {{ tilt }} hover:rotate-0 transition-transform duration-300 motion-reduce:rotate-0 motion-reduce:transition-none">
                    <twig:Card class="overflow-hidden p-0 gap-0 border-border/60 shadow-xl group-hover:shadow-2xl group-hover:ring-2 group-hover:ring-primary/50 transition-all duration-300">
                        <div class="relative aspect-[3/4] w-full overflow-hidden bg-muted">
                            <img src="{{ game.imageUrl }}" alt="{{ game.name }}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300" loading="lazy">
                            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/10 to-transparent"></div>
                            <twig:Badge variant="secondary" class="absolute top-2 right-2 text-[10px] backdrop-blur bg-background/60 border border-border/50">
                                Devine-moi
                            </twig:Badge>
                            <div class="absolute bottom-0 inset-x-0 p-3 space-y-1">
                                <p class="text-white font-bold text-sm leading-tight line-clamp-1">{{ game.name }}</p>
                                <p class="text-white/70 text-xs line-clamp-1">{{ game.publisher }}{% if game.releaseYear %} · {{ game.releaseYear }}{% endif %}</p>
                            </div>
                        </div>
                    </twig:Card>
                </div>
            {% endfor %}
        </div>
    </section>

    {# Leaderboard with podium #}
    <section id="classement" class="space-y-8">
        <div class="text-center space-y-2">
            <h2 class="text-3xl font-black tracking-tight uppercase">Le Panthéon</h2>
            <p class="text-muted-foreground">Les champions de la saison.</p>
        </div>

        {% if topScores|length > 0 %}
            <div class="flex items-end justify-center gap-4 sm:gap-8 pt-6">
                {% for score in topScores|slice(0, 3) %}
                    {% set rankConf = {
                        0: {order: 'sm:order-2', h: 'h-40', ring: 'ring-yellow-500/40', glow: 'shadow-[0_0_35px_rgba(234,179,8,0.3)]', badge: 'bg-yellow-500/20 text-yellow-500 ring-yellow-500/30', medal: '👑', size: 'h-20 w-20 text-2xl'},
                        1: {order: 'sm:order-1', h: 'h-28', ring: 'ring-slate-300/40', glow: 'shadow-[0_0_25px_rgba(203,213,225,0.2)]', badge: 'bg-slate-300/20 text-slate-300 ring-slate-300/30', medal: '🥈', size: 'h-16 w-16 text-lg'},
                        2: {order: 'sm:order-3', h: 'h-20', ring: 'ring-orange-500/40', glow: 'shadow-[0_0_25px_rgba(249,115,22,0.2)]', badge: 'bg-orange-500/20 text-orange-500 ring-orange-500/30', medal: '🥉', size: 'h-16 w-16 text-lg'},
                    }[loop.index0] %}
                    <div class="flex flex-col items-center gap-3 {{ rankConf.order }}">
                        <span class="text-2xl motion-reduce:hidden">{{ rankConf.medal }}</span>
                        <twig:Avatar class="{{ rankConf.size }} ring-2 {{ rankConf.ring }} {{ rankConf.glow }}">
                            <twig:Avatar:Fallback class="bg-muted font-black">
                                {{ score.player.userIdentifier|slice(0, 2)|upper }}
                            </twig:Avatar:Fallback>
                        </twig:Avatar>
                        <div class="text-center">
                            <p class="font-bold">{{ score.player.userIdentifier }}</p>
                            <p class="text-sm text-muted-foreground">{{ score.points|number_format(0, ',', ' ') }} pts</p>
                        </div>
                        <div class="w-24 sm:w-32 {{ rankConf.h }} rounded-t-lg {{ rankConf.badge }} ring-1 ring-inset flex items-start justify-center pt-2 font-black text-xl">
                            {{ loop.index }}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

        {% if topScores|length > 3 %}
            <twig:Card class="overflow-hidden shadow-xl border-border/50 bg-card/60 backdrop-blur-sm max-w-2xl mx-auto">
                <twig:Card:Content class="p-0">
                    <twig:Table>
                        <twig:Table:Body>
                            {% for score in topScores|slice(3) %}
                                {% set rank = loop.index + 3 %}
                                <twig:Table:Row class="group hover:bg-muted/30">
                                    <twig:Table:Cell class="px-6 py-3 align-middle font-medium text-muted-foreground w-16">{{ rank }}</twig:Table:Cell>
                                    <twig:Table:Cell class="px-6 py-3 align-middle">
                                        <div class="flex items-center space-x-3">
                                            <twig:Avatar class="h-8 w-8">
                                                <twig:Avatar:Fallback class="bg-muted text-muted-foreground font-semibold text-xs">
                                                    {{ score.player.userIdentifier|slice(0, 2)|upper }}
                                                </twig:Avatar:Fallback>
                                            </twig:Avatar>
                                            <span class="font-semibold group-hover:text-primary transition-colors">{{ score.player.userIdentifier }}</span>
                                        </div>
                                    </twig:Table:Cell>
                                    <twig:Table:Cell class="px-6 py-3 align-middle text-right">
                                        <twig:Badge variant="outline" class="font-bold bg-primary/10 text-primary border-primary/20">
                                            {{ score.points|number_format(0, ',', ' ') }} pts
                                        </twig:Badge>
                                    </twig:Table:Cell>
                                </twig:Table:Row>
                            {% endfor %}
                        </twig:Table:Body>
                    </twig:Table>
                </twig:Card:Content>
            </twig:Card>
        {% elseif topScores|length == 0 %}
            <p class="text-center text-muted-foreground">Aucun score n'a été enregistré pour le moment. Soyez le premier champion !</p>
        {% endif %}
    </section>
</div>
{% endblock %}
