{% extends ea().templatePath('layout') %}

{% block content_title %}Importer des jeux depuis RAWG{% endblock %}

{% block main %}
    <p class="text-muted">
        Choisis des critères différents (mot-clé, tri, dates, page) pour éviter de retomber
        sur les mêmes jeux à chaque import.
    </p>

    <form method="get" action="" class="mt-3">
        <input type="hidden" name="do" value="1">

        <div class="row g-3">
            <div class="col-md-6">
                <label for="search" class="form-label">Mot-clé (nom de jeu)</label>
                <input type="text" id="search" name="search" class="form-control" value="{{ defaults.search }}" placeholder="ex: zelda">
            </div>

            <div class="col-md-6">
                <label for="ordering" class="form-label">Tri</label>
                <select id="ordering" name="ordering" class="form-select">
                    {% for value, label in ordering_choices %}
                        <option value="{{ value }}" {{ value == defaults.ordering ? 'selected' : '' }}>{{ label }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="col-md-3">
                <label for="date_from" class="form-label">Sorties depuis le</label>
                <input type="date" id="date_from" name="date_from" class="form-control" value="{{ defaults.date_from }}">
            </div>

            <div class="col-md-3">
                <label for="date_to" class="form-label">Sorties jusqu'au</label>
                <input type="date" id="date_to" name="date_to" class="form-control" value="{{ defaults.date_to }}">
            </div>

            <div class="col-md-3">
                <label for="page" class="form-label">Page RAWG</label>
                <input type="number" id="page" name="page" class="form-control" min="1" value="{{ defaults.page }}">
                <div class="form-text">Change la page pour obtenir de nouveaux jeux.</div>
            </div>

            <div class="col-md-3">
                <label for="page_size" class="form-label">Nombre de résultats</label>
                <input type="number" id="page_size" name="page_size" class="form-control" min="1" max="40" value="{{ defaults.page_size }}">
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-download"></i> Lancer l'import
            </button>
            <a href="{{ ea_url().setController('App\\Controller\\Admin\\GameCrudController').setAction('index') }}" class="btn btn-secondary">
                Annuler
            </a>
        </div>
    </form>
{% endblock %}
